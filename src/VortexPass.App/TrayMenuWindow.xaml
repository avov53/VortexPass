<Window x:Class="VortexPass.App.TrayMenuWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="310" Height="300" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
 WindowStartupLocation="Manual" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#242424"/>
  <SolidColorBrush x:Key="Text" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Muted" Color="#999999"/>
  <SolidColorBrush x:Key="Line" Color="#404040"/>
  <SolidColorBrush x:Key="Hover" Color="#353535"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="Transparent" CornerRadius="9"><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="10">
  <Border CornerRadius="16" Padding="14" BorderThickness="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
   <StackPanel>
    <TextBlock Text="VortexPass" FontWeight="SemiBold" FontSize="15" Margin="8,3,0,12"/>
    <Border x:Name="StatusPanel" CornerRadius="9" Padding="9" BorderThickness="0">
     <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0"/>
      <TextBlock x:Name="StatusText" FontSize="12"/><TextBlock x:Name="StatusHint" Visibility="Collapsed"/>
     </StackPanel>
    </Border>
    <Button x:Name="OpenButton" Click="OpenButton_Click" Margin="0,7,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="↗" Width="26"/><TextBlock Text="Открыть VortexPass"/></StackPanel></Button>
    <Button x:Name="ProtectionButton" Click="ProtectionButton_Click"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ProtectionGlyph" Text="◉" Width="26"/><TextBlock x:Name="ProtectionText" Text="Запустить защиту"/></StackPanel></Button>
    <Button x:Name="WarpButton" Click="WarpButton_Click"><StackPanel Orientation="Horizontal"><TextBlock x:Name="WarpGlyph" Text="◇" Width="26"/><TextBlock x:Name="WarpText" Text="Включить WARP"/></StackPanel></Button>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,5,0,0">
     <Button x:Name="ExitButton" Click="ExitButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="×" Width="26" Foreground="#DC6666"/><TextBlock Text="Выйти из VortexPass" Foreground="#DC6666"/></StackPanel></Button>
    </Border>
   </StackPanel>
  </Border>
 </Grid>
</Window>
