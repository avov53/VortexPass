<Window x:Class="VortexPass.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="322" Height="340" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" ShowActivated="True" WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="12">
    <Border CornerRadius="22" Padding="14" BorderThickness="1"
            Background="#F014141F" BorderBrush="#523A3A56">
      <Border.Effect>
        <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.48" Color="#000000" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,1,2,13">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="12" BorderThickness="1"
                  Background="#F21D1119" BorderBrush="#7ACB3554">
            <Border.Effect>
              <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#C92042" />
            </Border.Effect>
            <Image Source="Assets/VortexPass-logo.png" Width="30" Height="30" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="VortexPass" FontFamily="Segoe UI Semibold" FontWeight="SemiBold"
                       FontSize="14" Foreground="#FFF4F2F6" />
            <TextBlock Text="Network Manager" FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"
                       Foreground="#FF9692B4" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="StatusPanel" CornerRadius="12" Padding="10,8" BorderThickness="1"
                Background="#151F1630" BorderBrush="#353C3A57">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF706A86" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="10" Foreground="#FF9B97B3" Text="Защита выключена" />
            <TextBlock x:Name="StatusHint" Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas"
                       FontSize="9" Foreground="#FF626078" Text="Idle" />
          </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,11,0,10">
          <Button x:Name="OpenButton" Click="OpenButton_Click" Cursor="Hand" Height="38" Padding="11,0"
                  HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="buttonBorder" Background="Transparent" CornerRadius="11">
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonBorder" Property="Background" Value="#12FFFFFF" /></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonBorder" Property="Background" Value="#216C5CE7" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="↗" FontSize="18" Foreground="#FFC8C2E8" VerticalAlignment="Center" />
              <TextBlock Text="Открыть VortexPass" Margin="10,0,0,0" FontFamily="Segoe UI Semibold" FontSize="12" Foreground="#FFF0EFF8" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ProtectionButton" Click="ProtectionButton_Click" Cursor="Hand" Height="38" Padding="11,0"
                  HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="buttonBorder" Background="Transparent" CornerRadius="11">
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonBorder" Property="Background" Value="#146C5CE7" /></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonBorder" Property="Background" Value="#246C5CE7" /></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="buttonBorder" Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ProtectionGlyph" Text="◉" FontSize="15" Foreground="#FFC5BFFF" VerticalAlignment="Center" />
              <TextBlock x:Name="ProtectionText" Text="Запустить защиту" Margin="10,0,0,0" FontFamily="Segoe UI Semibold" FontSize="12" Foreground="#FFF0EFF8" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="WarpButton" Click="WarpButton_Click" Cursor="Hand" Height="38" Padding="11,0"
                  HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="buttonBorder" Background="Transparent" CornerRadius="11">
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonBorder" Property="Background" Value="#140078D4" /></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonBorder" Property="Background" Value="#240078D4" /></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="buttonBorder" Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="WarpGlyph" Text="◈" FontSize="15" Foreground="#FF62AFFF" VerticalAlignment="Center" />
              <TextBlock x:Name="WarpText" Text="Включить WARP" Margin="10,0,0,0" FontFamily="Segoe UI Semibold" FontSize="12" Foreground="#FFF0EFF8" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="#2BFFFFFF" BorderThickness="0,1,0,0" Padding="0,9,0,0">
          <Button x:Name="ExitButton" Click="ExitButton_Click" Cursor="Hand" Height="36" Padding="11,0"
                  HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="buttonBorder" Background="Transparent" CornerRadius="11">
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonBorder" Property="Background" Value="#18FF4D6D" /></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonBorder" Property="Background" Value="#28FF4D6D" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="×" FontSize="19" Foreground="#FFFF869A" VerticalAlignment="Center" />
              <TextBlock Text="Выйти из VortexPass" Margin="10,0,0,0" FontFamily="Segoe UI Semibold" FontSize="12" Foreground="#FFFFA0AF" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
